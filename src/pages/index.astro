---
import Layout from "../layouts/Layout.astro";
import AuthGate from "../components/AuthGate";
import LogoutButton from "../components/LogoutButton";
import Countdown from "../components/Countdown";
import Gallery from "../components/Gallery";
import RsvpForm from "../components/RsvpForm";
import { readGuestSession } from "../lib/auth";

const guestSession = readGuestSession(
  Astro.cookies.get("wedding_session")?.value
);
---

<Layout
  title="Ian & Riley — We're Getting Married"
  description="Join Ian & Riley as they celebrate their wedding."
>
  {guestSession ? (
    <>
      <header class="site-header">
        <a href="#top" class="wordmark">I & R</a>

        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="#story">Our Story</a>
          <a href="#weekend">Weekend</a>
          <a href="#details">Details</a>
          <a href="#gallery">Gallery</a>
          <a href="/attire">Attire</a>
          <a href="#rsvp">RSVP</a>
        </nav>

        <LogoutButton client:load />
      </header>

      <main id="top">

        <!-- HERO -->
        <section class="hero">
          <div class="hero-decoration hero-decoration-left"></div>
          <div class="hero-decoration hero-decoration-right"></div>

          <div class="hero-content">
            <p class="eyebrow">WE'RE GETTING MARRIED</p>

            <h1>
              Ian
              <span>&</span>
              Riley
            </h1>

            <p class="hero-date">
              July 1, 2028 · Merrywood Farm, Oregon
            </p>

            <Countdown
              targetDate="2028-07-01T16:00:00-07:00"
              client:load
            />

            <a href="#rsvp" class="button button-light">
              RSVP
            </a>
          </div>
        </section>

        <!-- STORY -->
        <section id="story" class="section section-light">
          <div class="section-inner story-grid">
            <div class="story-feature">
              <p class="eyebrow">OUR STORY</p>
              <h2>
                From one chapter<br />
                to the next.
              </h2>
              <figure class="story-photo-frame">
                <img
                  class="story-photo"
                  src="/images/happyCouple.jpeg"
                  alt="Riley and Ian together during their engagement photo session"
                  loading="lazy"
                />
              </figure>
            </div>

            <div class="story-copy">
              <p>
                Riley and Ian met in 2023 while attending California Polytechnic State University. 
                They first met while studying in Kennedy Library, when Riley helped Ian through his 
                intro-to-programming assignment. The couple dated through college, visiting each others’ 
                hometowns, taking trips together, and planning a life together post graduation. 
                Their families met for the first time in San Luis Obispo for graduation weekend, 
                including both sets of Ian’s grandparents. The summer after graduation, Riley toured 
                Europe with her college girlfriends, and Ian spent a month on his family farm, 
                before the couple moved in to their first apartment together in July of 2025. 
                Riley and Ian started their next chapter in sunny San Jose, California as incoming 
                Engineers at the LM Space Sunnyvale campus. They met incredible friends, undertook 
                exciting challenges, and created a beautiful life together.
              </p>

              <p>
                In September of 2026, Ian proposed to Riley at the Santana Heights fountain, and she 
                said yes! The proposal was followed by a surprise party with Riley's parents and 
                all of their lifelong friends. A couples trip to SLO followed for an engagement 
                photo session. The proposal celebration continued with a trip to Oregon, where The 
                Froomin’s, The Keyser’s, and The Cernitz’s all got to spend a weekend together filled 
                with music, toasts, and excitement. Now, Riley and Ian are thrilled to welcome all of 
                their loved ones to Merrywood Farm for this grand occasion. Cheers!

              </p>
            </div>
          </div>
        </section>

        <!-- WEEKEND -->
        <section id="weekend" class="section section-weekend">
          <div class="section-inner">
            <div class="section-heading">
              <p class="eyebrow">THE WEEKEND</p>
              <h2>Celebrate with us.</h2>
            </div>

            <div class="weekend-photo-strip" aria-label="Engagement photographs">
              <figure class="weekend-photo weekend-photo-wide">
                <img src="/images/patio.jpeg" alt="Riley and Ian together outside on a sunny afternoon" loading="lazy" />
              </figure>
              <figure class="weekend-photo">
                <img src="/images/barCheers.jpeg" alt="Riley and Ian celebrating together" loading="lazy" />
              </figure>
              <figure class="weekend-photo">
                <img src="/images/dancing.JPG" alt="Riley and Ian dancing together by the ocean" loading="lazy" />
              </figure>
            </div>

            <div class="timeline">
              
            {guestSession.rehearsalDinnerInvited && (
              <article class="timeline-item">
                <div class="timeline-date">
                  <span>FRI</span>
                  <strong>30</strong>
                </div>

                <div>
                  <p class="timeline-label">6:00 PM</p>
                  <h3>Rehearsal Dinner</h3>
                  <p>
                    We look forward to celebrating with you at our
                    rehearsal dinner and kicking off the wedding weekend
                    together.
                  </p>
                </div>
              </article>
            )}


              <article class="timeline-item">
                <div class="timeline-date">
                  <span>SAT</span>
                  <strong>1</strong>
                </div>

                <div>
                  <p class="timeline-label">4:00 PM</p>
                  <h3>The Ceremony</h3>
                  <p>
                    Ian and Riley's wedding ceremony, dinner and reception.
                  </p>
                </div>
              </article>

              {guestSession.farewellBrunchInvited && (
                <article class="timeline-item">
                  <div class="timeline-date">
                    <span>SUN</span>
                    <strong>2</strong>
                  </div>

                  <div>
                    <p class="timeline-label">11:00 AM</p>
                    <h3>Farewell Brunch</h3>
                    <p>
                      One last meal together before everyone heads home.
                    </p>
                  </div>
                </article>
              )}
            </div>
          </div>
        </section>

        <!-- DETAILS -->
        <section id="details" class="section section-light">
          <div class="section-inner">
            <div class="section-heading">
              <p class="eyebrow">DETAILS</p>
              <h2>Everything you need to know.</h2>
            </div>

            <div class="details-grid">
              <article class="detail-card">
                <span class="detail-number">01</span>
                <h3>Venue</h3>
                <p>
                  Merrywood Farm<br />
                  12328 South Casto Road<br />
                  Oregon City, Oregon
                </p>
              </article>

              
              <article class="detail-card">
                <span class="detail-number">02</span>
                <h3>Dress Code</h3>

                <div class="detail-description">
                  <p class="dress-code-label">Garden Party Attire</p>

                  <p>
                    We invite you to dress in soft pastels, floral prints, and
                    tea-length or ankle-length dresses for the occasion. For
                    gentlemen, we’d love to see fun, colorful suits, though
                    classic black is always welcome, too!
                  </p>

                  <a href="/attire" class="attire-detail-link">
                    Explore the attire lookbook <span class="shop-arrow" aria-hidden="true">↗︎</span>
                  </a>
                </div>
              </article>

              <article class="detail-card">
                <span class="detail-number">03</span>
                <h3>Travel</h3>
                <p>
                  Hotel blocks, transportation, airport information, and all the
                  practical details can live here.
                </p>
              </article>

              <article class="detail-card">
                <span class="detail-number">04</span>
                <h3>Registry</h3>
                <p>
                  Our registry links can go here once they're ready.
                </p>
              </article>
            </div>
          </div>
        </section>

        <!-- GALLERY -->
        <section id="gallery" class="section section-blush">
          <div class="section-inner">
            <div class="section-heading">
              <p class="eyebrow">A FEW OF OUR FAVORITE MOMENTS</p>
              <h2>Us, lately.</h2>
            </div>

            <Gallery client:load />
          </div>
        </section>

        <!-- RSVP -->
        <section id="rsvp" class="section section-dark">
          <div class="section-inner rsvp-layout">
            <div>
              <p class="eyebrow">RSVP</p>

              <h2>
                We hope<br />
                you'll be there.
              </h2>

              <p class="rsvp-intro">
                Please respond by July 1, 2027.
              </p>
            </div>

            <RsvpForm
              client:load
              guests={guestSession.guests}
            />
          </div>
        </section>

      </main>

      <footer class="site-footer">
        <p>Ian & Riley · 2028</p>
        <a href="#top">Back to top ↑</a>
      </footer>
    </>
  ) : (
    <AuthGate client:load />
  )}
</Layout>